[Unit]
Description=Karipaza Froxy Telegram Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/karipuza-bot
EnvironmentFile=/opt/karipuza-bot/.env
ExecStart=/opt/karipuza-bot/venv/bin/python3 -m karipuza_bot.webapp
Restart=always
RestartSec=5
User=karipuza
Group=karipuza
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/karipuza-bot/data

[Install]
WantedBy=multi-user.target

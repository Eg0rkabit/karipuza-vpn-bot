BOT_TOKEN=token_from_botfather
ADMIN_IDS=123456789,987654321

DATABASE_PATH=/opt/karipuza-bot/data/karipuza.db

MINI_APP_URL=https://app.karipuza.ru
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
WEBAPP_DEV_AUTH=false
WEBAPP_AUTH_TTL_SECONDS=86400

# Remnawave Panel API, доступный только локально на VPS.
REMNAWAVE_URL=http://127.0.0.1:3002
REMNAWAVE_API_TOKEN=token_created_in_remnawave
REMNAWAVE_SQUAD_UUIDS=00000000-0000-0000-0000-000000000000

# Перенос строки внутри значения записывается как \n.
PAYMENT_DETAILS=Перевод по СБП: +7 900 000-00-00\nПолучатель: Имя

# Пока значения пустые, бот и Mini App работают с ручной проверкой оплаты.
# Когда будет аккаунт ЮKassa, сюда можно будет добавить данные магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://app.karipuza.ru

ACTION_COOLDOWN_SECONDS=0.8
HEAVY_ACTION_COOLDOWN_SECONDS=3
